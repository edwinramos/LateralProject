{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=LateralProjectDb;Username=postgres;Password=postgres"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },

  "AllowedHosts": "*"
}